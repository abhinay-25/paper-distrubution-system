NODE_ENV=development
PORT=4000

# Origin allowed to call the API from a browser (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection URL — matches the docker-compose.yml dev credentials.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://pds_dev:pds_dev_local@localhost:5432/pds_dev

# Authentication & Session Security (Step 6)
# In production, generate a unique 48-byte secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
SESSION_TTL_HOURS=8

# Optional password used only when running `npm run db:seed` in development/demo environments
# DEMO_SEED_PASSWORD=replace_with_demo_seed_password

# Internal AI service (Python microservice)
# Must match INTERNAL_SERVICE_TOKEN in ai-service/.env.
# In production, generate a unique 48-byte token: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=dev_internal_service_secret_token_at_least_32_chars_long_for_security
# Standard AI operation timeout (ms) and batch question-generation timeout (ms).
# AI_GENERATION_TIMEOUT_MS (70000ms) is sized above Python's worst-case retry budget (~57s).
AI_SERVICE_TIMEOUT_MS=35000
AI_GENERATION_TIMEOUT_MS=70000

# Private directory for generated examination paper PDF artifacts (outside public web root)
PDF_STORAGE_DIR=./storage/pdf-artifacts

