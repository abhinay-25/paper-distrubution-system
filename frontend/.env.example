# Frontend Public Environment Configuration
#
# ⚠️ SECURITY WARNING: Every variable prefixed with VITE_ is embedded into the
# public browser JavaScript bundle. NEVER place API keys, database URLs,
# internal tokens, or private secrets in this file.

# Optional backend origin override.
# Leave empty in local development to use the Vite dev server proxy (/api/v1 -> http://localhost:4000).
# Set to the public backend origin in staging/production (e.g. https://api.example.edu).
VITE_API_BASE_URL=

