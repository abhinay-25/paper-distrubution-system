# Environment: development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Internal Service Authentication (Backend -> AI Service) ---
# Required. Minimum 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must match the AI_SERVICE_TOKEN in backend/.env
INTERNAL_SERVICE_TOKEN=dev_internal_service_secret_token_at_least_32_chars_long_for_security

# --- Generative AI Provider (Ollama 100% Local or Gemini Cloud) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional if using Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Limits and Failure Policies ---
AI_REQUEST_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=1
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=4.0
AI_MAX_OUTPUT_TOKENS=8192
MAX_REQUEST_BYTES=65536
MAX_INPUT_CHARS=8000
